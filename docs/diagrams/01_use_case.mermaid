        UC10(["Attend Voice Mock Interview"])
        UC11(["Use Panic Control"])
        UC12(["Receive Interview Feedback"])
        UC13(["Plan Career Path"])
        UC14(["Take Mock Exam & Get Certificate"])
        UC15(["Chat with AI Assistant"])
